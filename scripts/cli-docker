#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${ROOT_DIR}"

if [ "$#" -eq 0 ]; then
  echo "Usage: ./scripts/cli-docker <command> [args...]"
  echo "Example: ./scripts/cli-docker nukeAndPave"
  exit 1
fi

# Run CLI inside the API container to use container network/env (DB_HOST=postgres, DB_PORT=5432).
docker compose -f compose.yml exec api dotnet /app/cli/CLI.dll "$@"

