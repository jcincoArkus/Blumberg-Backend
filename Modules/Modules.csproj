<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" Version="4.0.2.17" />
    <PackageReference Include="AWSSDK.SimpleEmail" Version="3.7.502.50" />
  </ItemGroup>

  <!-- Exclude subfolders that are separate projects -->
  <ItemGroup>
    <Compile Remove="Auth\**\*.cs" />
    <Compile Remove="Permissions\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Adapters/Database/Adapters.Database.csproj" />
    <ProjectReference Include="../Shared/Shared.csproj" />
    <ProjectReference Include="Auth/Modules.Auth.csproj" />
    <ProjectReference Include="..\Adapters\Telemetry\Adapters.Telemetry.csproj" />
    <ProjectReference Include="Permissions\Modules.Permissions.csproj" />
  </ItemGroup>

</Project>

