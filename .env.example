# Application
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# CORS allowed origins (comma-separated).
# REQUIRED in all environments.
# Local example:
# CORS_ORIGINS=http://localhost:5080
# AWS example:
# CORS_ORIGINS=https://your-dev-frontend.example.com
CORS_ORIGINS=http://localhost:5080

# Logger Configuration
LOG_LEVEL=Debug # Debug, Information, Warning, Error, Fatal
LOG_FORMAT_JSON=false
LOG_WRITE_FILE=true
LOG_FILE_PATH=logs/blumberg-.json
LOG_RETENTION_DAYS=30

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_SERVICE_NAME=Blumberg.API
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER=console # Options: console, otlp, datadog, console,otlp

# OTLP Exporter Configuration (for Jaeger or custom OTLP endpoints)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc # Options: grpc, http/protobuf
OTEL_EXPORTER_OTLP_HEADERS= # Format: key1=value1,key2=value2

# Datadog Exporter Configuration (simplified)
# Use OTEL_EXPORTER=datadog and set these variables:
OTEL_DATADOG_API_KEY= # Your Datadog API key
OTEL_DATADOG_SITE=datadoghq.com # Options: datadoghq.com, datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, ddog-gov.com (e.g., dd-api-key=YOUR_DATADOG_API_KEY)

# Instrumentation Toggles
OTEL_INSTRUMENTATION_EF_ENABLED=true
OTEL_INSTRUMENTATION_HTTP_ENABLED=true
OTEL_INSTRUMENTATION_ASPNETCORE_ENABLED=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blumberg
DB_USER=blumberg
DB_PASSWORD=blumberg

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key
JWT_ISSUER=Blumberg.API
JWT_AUDIENCE=Blumberg.Client
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Alert Email Configuration
ALERT_EMAIL_PROVIDER=Smtp
SMTP_HOST=your-smtp-host
SMTP_PORT=587          # no use 465, use 587
SMTP_USE_SSL=true
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your-app-password

# Email queue worker (SQS + SES)
# In ECS, these are injected into the container task by your task definition.
WORKER_QUEUE_URL= # Ej: https://sqs.us-west-2.amazonaws.com/123456789012/mi-cola
# Usamos únicamente `SMTP_FROM_ADDRESS` como Source en SES.



