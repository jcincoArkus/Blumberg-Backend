{
  "info": {
    "name": "Blumberg Inventory API",
    "_postman_id": "blumberg-inventory-api-v1",
    "description": "Full CRUD collection for the Inventory module. Set the `baseUrl` and `token` variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token",   "value": "YOUR_BEARER_TOKEN",     "type": "string" },
    { "key": "categoryId",  "value": "", "type": "string" },
    { "key": "siteId",      "value": "", "type": "string" },
    { "key": "zoneId",      "value": "", "type": "string" },
    { "key": "supplierId",  "value": "", "type": "string" },
    { "key": "productId",   "value": "", "type": "string" },
    { "key": "lotCode",     "value": "L-250501-01", "type": "string" },
    { "key": "movementId",  "value": "", "type": "string" },
    { "key": "shipmentId",  "value": "", "type": "string" },
    { "key": "shipmentLineId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventory/categories?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventory", "categories"],
              "query": [
                { "key": "page",     "value": "1"  },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Category by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventory/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventory", "categories", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('categoryId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fruit\",\n  \"color\": \"teal\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventory/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventory", "categories"]
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fruit (Updated)\",\n  \"color\": \"green\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventory/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventory", "categories", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventory/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventory", "categories", "{{categoryId}}"]
            }
